@echo off
chcp 65001 >nul
cls
echo.
echo ╔════════════════════════════════════════════════════════╗
echo ║     图书馆预约管理系统 v2.0 - 一键启动脚本          ║
echo ╚════════════════════════════════════════════════════════╝
echo.
echo [提示] 本脚本将同时启动前端和后端服务
echo.
echo ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo.

:: 启动后端服务（新窗口）
echo [1/2] 启动后端服务...
start "图书馆预约系统-后端服务" cmd /k "%~dp0启动后端服务.bat"
timeout /t 3 >nul

:: 启动前端界面（新窗口）
echo [2/2] 启动前端界面...
start "图书馆预约系统-前端界面" cmd /k "%~dp0启动前端界面.bat"
timeout /t 2 >nul

echo.
echo ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo.
echo ✓ 服务启动完成！
echo.
echo 📍 后端服务: http://127.0.0.1:5000
echo 📍 前端界面: http://127.0.0.1:8080
echo.
echo ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
echo.
echo [提示] 稍等片刻后，浏览器访问 http://127.0.0.1:8080
echo [提示] 如需停止服务，关闭对应窗口即可
echo.

timeout /t 5 >nul

:: 自动打开浏览器
start http://127.0.0.1:8080

echo 按任意键退出此窗口...
pause >nul
