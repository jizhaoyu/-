# ==================== 数据库配置 ====================
# 复制本文件为 .env 并按实际情况修改：
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)

# 数据库类型：mysql（默认）或 sqlite
DB_TYPE=mysql

# MySQL 连接配置（DB_TYPE=mysql 时生效）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=library_reservation
DB_CHARSET=utf8mb4
